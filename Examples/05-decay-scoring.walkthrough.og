/*
  Decay scoring walkthrough.

  Run against a fresh database:
    swift run --disable-sandbox overgraph-cli --db /tmp/og-decay --run-script Examples/05-decay-scoring.walkthrough.og

  This script assumes an empty database so node IDs are:
    1 = alice
    2 = atlas
    3 = mercury

  Alice is linked to two projects with equal base weight, but one edge is much
  older. With decay enabled, the newer edge should rank higher.
*/

upsert-node 1 person:alice --props '{name: "Alice"}'
upsert-node 2 project:atlas --props '{name: "Atlas"}'
upsert-node 2 project:mercury --props '{name: "Mercury"}'

upsert-edge 1 2 11 --props '{role: "legacy"}' --weight 1.0 --valid-from 2024-01-01
upsert-edge 1 3 11 --props '{role: "current"}' --weight 1.0 --valid-from 2024-06-01

/* Without decay, both edges keep their raw weight. */
neighbors 1 --direction outgoing --at-epoch 2024-06-15

/* With decay, the more recent edge should score higher. */
neighbors 1 --direction outgoing --at-epoch 2024-06-15 --decay-lambda 0.1

quit
