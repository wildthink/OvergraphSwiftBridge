/*
  Lifecycle and cleanup example.

  Run against a fresh database:
    swift run --disable-sandbox overgraph-cli --db /tmp/og-lifecycle --run-script Examples/03-lifecycle-and-cleanup.walkthrough.og

  This script assumes an empty database so node IDs are:
    1 = spec
    2 = build
    3 = ship
*/

upsert-node Task spec --props '{"title":"Write spec","state":"done"}'
upsert-node Task build --props '{"title":"Build bridge","state":"active"}'
upsert-node Task ship --props '{"title":"Ship CLI","state":"todo"}'

/* Task dependency edges. */
upsert-edge 2 1 DEPENDS_ON --props '{"why":"needs design"}'
upsert-edge 3 2 DEPENDS_ON --props '{"why":"needs implementation"}'

nodes-by-label Task
neighbors 3 --direction outgoing
neighbors 2 --direction incoming

/* Remove the shipping task edge, then the shipping task. */
delete-edge 2
delete-node 3

nodes-by-label Task
stats

quit
