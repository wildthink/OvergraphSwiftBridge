/*
  Social graph walkthrough.

  Run against a fresh database:
    swift run --disable-sandbox overgraph-cli --db /tmp/og-social --run-script Examples/01-social-graph.walkthrough.og

  This script assumes an empty database so node IDs are:
    1 = alice
    2 = bob
    3 = carol
*/

upsert-node Person alice --props '{"name":"Alice","role":"engineer","team":"search"}'
upsert-node Person bob --props '{"name":"Bob","role":"designer","team":"search"}'
upsert-node Person carol --props '{"name":"Carol","role":"manager","team":"platform"}'

/* Connect Alice to Bob and Carol. */
upsert-edge 1 2 KNOWS --props '{"relationship":"teammate"}'
upsert-edge 1 3 KNOWS --props '{"relationship":"manager"}'
upsert-edge 2 3 KNOWS --props '{"relationship":"cross-functional"}'

/* Typical lookups. */
get-node-by-key Person alice
get-node 2
nodes-by-label Person
neighbors 1 --direction outgoing
neighbors 3 --direction incoming
stats

quit
