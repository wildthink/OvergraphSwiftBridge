/*
  Knowledge graph style example.

  Run against a fresh database:
    swift run --disable-sandbox overgraph-cli --db /tmp/og-knowledge --run-script Examples/02-knowledge-graph.walkthrough.og

  This script assumes an empty database so node IDs are:
    1 = alice
    2 = atlas
    3 = roadmap
*/

upsert-node Person alice --props '{"name":"Alice","kind":"person"}'
upsert-node Project atlas --props '{"name":"Atlas","kind":"project","status":"active"}'
upsert-node Document roadmap --props '{"title":"Q3 Roadmap","kind":"document"}'

/* Edge labels:
   WORKS_ON
   REFERENCES
*/
upsert-edge 1 2 WORKS_ON --props '{"role":"lead"}'
upsert-edge 3 2 REFERENCES --props '{"reason":"planning"}'
upsert-edge 1 3 REFERENCES --props '{"reason":"owns"}'

/* Query patterns:
   - key lookup
   - label scan
   - neighbor traversal with edge label filtering
*/
get-node-by-key Project atlas
nodes-by-label Project
neighbors 1 --direction outgoing --edge-labels WORKS_ON,REFERENCES
neighbors 2 --direction incoming
stats

quit
