/*
  Knowledge graph style example.

  Run against a fresh database:
    swift run --disable-sandbox overgraph-cli --db /tmp/og-knowledge --run-script Examples/02-knowledge-graph.walkthrough.og

  This script assumes an empty database so node IDs are:
    1 = alice
    2 = atlas
    3 = roadmap
*/

upsert-node 1 person:alice --props '{"name":"Alice","kind":"person"}'
upsert-node 2 project:atlas --props '{"name":"Atlas","kind":"project","status":"active"}'
upsert-node 3 doc:roadmap --props '{"title":"Q3 Roadmap","kind":"document"}'

/* Type IDs:
   11 = works_on
   12 = references
*/
upsert-edge 1 2 11 --props '{"role":"lead"}'
upsert-edge 3 2 12 --props '{"reason":"planning"}'
upsert-edge 1 3 12 --props '{"reason":"owns"}'

/* Query patterns:
   - key lookup
   - type scan
   - neighbor traversal with type filtering
*/
get-node-by-key 2 project:atlas
nodes-by-type 2
neighbors 1 --direction outgoing --types 11,12
neighbors 2 --direction incoming
stats

quit
