/*
  Temporal edge walkthrough.

  Run against a fresh database:
    swift run --disable-sandbox overgraph-cli --db /tmp/og-temporal --run-script Examples/04-temporal-edges.walkthrough.og

  This script assumes an empty database so node IDs are:
    1 = alice
    2 = atlas
    3 = mercury
*/

upsert-node Person alice --props '{name: "Alice"}'
upsert-node Project atlas --props '{name: "Atlas"}'
upsert-node Project mercury --props '{name: "Mercury"}'

/* Alice worked on Atlas from Jan through May, then moved to Mercury in June. */
upsert-edge 1 2 WORKS_ON --props '{role: "lead"}' --valid-from 2024-01-01 --valid-to 2024-05-01
upsert-edge 1 3 WORKS_ON --props '{role: "lead"}' --valid-from 2024-06-01

/* Current view sees only currently-valid edges. */
neighbors 1 --direction outgoing

/* As-of query in March 2024 sees Atlas. */
neighbors 1 --direction outgoing --asof 2024-04-01

/* As-of query in June 2024 sees Mercury. */
neighbors 1 --direction outgoing --at-epoch 2024-06-01

stats
quit
